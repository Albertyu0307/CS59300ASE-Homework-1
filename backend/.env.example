# Copy this file to .env (same folder) and fill in the values.
# .env is gitignored -- never commit a real API key.

# LLM: Google Gemini's free tier through its OpenAI-compatible endpoint. Any other
# OpenAI-compatible provider works too: change the URL, key and model.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Free key from https://aistudio.google.com (create it in a project WITHOUT billing, so it costs $0).
# Leave blank for keyless providers.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# true = return canned text instead of calling the LLM (no key or quota needed).
# Set it to false once LLM_API_KEY is filled in.
LLM_MOCK=true
# Longer paper texts are cut to this many characters before they're sent to the LLM.
LLM_MAX_PAPER_CHARS=200000

# Where the SQLite database and PDFs are stored (relative paths are relative to backend/).
DATA_DIR=./data
