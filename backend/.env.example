# Copy this file to .env (same folder) and fill in the values.
# .env is gitignored -- never commit a real API key.

# LLM provider (decided in Phase 4). Any OpenAI-compatible endpoint works.
LLM_BASE_URL=
# Leave blank for keyless providers.
LLM_API_KEY=
LLM_MODEL=
# true = return canned text instead of calling the LLM (no key or quota needed).
LLM_MOCK=true

# Where the SQLite database and PDFs are stored (relative paths are relative to backend/).
DATA_DIR=./data
