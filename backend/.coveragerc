# coverage.py settings for the backend (statement and branch coverage of app/), read by
# tools/run_coverage.py and by `python -m coverage ...` run from backend/. See README.md,
# "Measuring code coverage".

[run]
branch = True
source = app
# The browser tests run the server in a thread of the test process; coverage.py follows threads by
# default, so the requests they make count too.

[report]
show_missing = True
skip_empty = True
precision = 1

[html]
directory = coverage-report/html

[json]
output = coverage-report/backend.json
